# ======================================================================
# STUDY 1
# Configuration Relaxation and Energy Minimization of a Binary LJ Fluid
# ======================================================================

# Create the frames folder only if it does not already exist.
shell mkdir frames

# ----------------------------------------------------------------------
# 1) INITIALIZATION
# ----------------------------------------------------------------------

# Use Lennard-Jones reduced units.
units lj

# Run a three-dimensional simulation.
dimension 3

# Use atomic particles with no bonds.
atom_style atomic

# Apply periodic boundaries in x, y, and z.
boundary p p p


# ----------------------------------------------------------------------
# 2) SYSTEM DEFINITION
# ----------------------------------------------------------------------

# Define the cubic simulation region.
region simbox block -20 20 -20 20 -20 20

# Create a simulation box with two atom types.
create_box 2 simbox

# Randomly create 1500 atoms of type 1 with overlap control.
create_atoms 1 random 1500 34134 simbox overlap 0.3

# Randomly create 100 atoms of type 2 with overlap control.
create_atoms 2 random 100 12756 simbox overlap 0.3

# Assign the mass of atom type 1.
mass 1 1.0

# Assign the mass of atom type 2.
mass 2 5.0


# ----------------------------------------------------------------------
# 3) SETTINGS
# ----------------------------------------------------------------------

# Use a Lennard-Jones pair style with cutoff radius 4.0.
pair_style lj/cut 4.0

# Set the Lennard-Jones parameters for type 1 with itself.
pair_coeff 1 1 1.0 1.0

# Set the Lennard-Jones parameters for type 2 with itself.
pair_coeff 2 2 0.5 3.0


# ----------------------------------------------------------------------
# 4) MONITORING
# ----------------------------------------------------------------------

# Compute per-atom potential energy for trajectory output.
compute peatom all pe/atom

# Compute per-atom speed magnitude for trajectory output.
variable vmag atom sqrt(vx*vx+vy*vy+vz*vz)

# Print thermo output every minimizer iteration.
thermo 1

# Select thermo columns.
thermo_style custom step etotal pe press

# Dump PNG frames every 100 minimizer iterations.
dump dump_png all image 100 frames/frame_*.png type type size 1200 1200 zoom 1.45 shiny 0.60 fsaa yes view 70 25 box yes 0.025 axes no 0.0 0.0 center s 0.5 0.5 0.5

# Set PNG frame colors and atom diameters.
dump_modify dump_png pad 4 backcolor white boxcolor gray acolor 1 blue acolor 2 red adiam 1 1.6 adiam 2 4.8

# Dump the transient trajectory for post-processing.
dump dump_traj all custom 5 study_1___transient.lammpstrj id type mass x y z vx vy vz v_vmag fx fy fz c_peatom

# Sort atoms by ID in the trajectory output.
dump_modify dump_traj sort id


# ----------------------------------------------------------------------
# 5) RUN
# ----------------------------------------------------------------------

# Run the energy minimization.
minimize 1.0e-6 1.0e-6 1000 10000

# Stop PNG frame dumping.
undump dump_png

# Stop transient trajectory dumping.
undump dump_traj

# Write the minimized final configuration.
write_data study_1___minimized.data