# ======================================================================
# STUDY 4B
# Mixing Dynamics and Interspecies Coordination Evolution
# of a Binary LJ Fluid
# ======================================================================

# Create the frames folder only if it does not already exist.
shell mkdir frames

# ----------------------------------------------------------------------
# 1) INITIALIZATION
# ----------------------------------------------------------------------

# Use Lennard-Jones reduced units.
units lj

# Run a three-dimensional simulation.
dimension 3

# Use atomic particles with no bonds.
atom_style atomic

# Apply periodic boundaries in x, y, and z.
boundary p p p


# ----------------------------------------------------------------------
# 2) SYSTEM DEFINITION
# ----------------------------------------------------------------------

# Define the Lennard-Jones pair style before reading the data file.
pair_style lj/cut 4.0

# Use geometric mixing for cross interactions.
pair_modify mix geometric

# Read the minimized configuration generated in Study 4A.
read_data study_4a___minimized.data

# Define the inner cylindrical region used to monitor mixing.
region cyl_in cylinder z 0.0 0.0 10.0 INF INF side in

# Define the outer region as the complement of the inner cylinder.
region cyl_out cylinder z 0.0 0.0 10.0 INF INF side out

# Define groups for each atom type.
group grp_t1 type 1
group grp_t2 type 2

# Define temporary groups for atoms located in the inner and outer regions.
group grp_in region cyl_in
group grp_out region cyl_out

# Identify type-1 atoms inside the inner cylinder.
group grp_t1_in intersect grp_t1 grp_in

# Identify type-2 atoms outside the inner cylinder.
group grp_t2_out intersect grp_t2 grp_out

# Remove type-1 atoms from the inner cylinder.
delete_atoms group grp_t1_in

# Remove type-2 atoms from the outer region.
delete_atoms group grp_t2_out

# Delete temporary groups that are no longer needed.
group grp_in delete
group grp_out delete
group grp_t1_in delete
group grp_t2_out delete


# ----------------------------------------------------------------------
# 3) SETTINGS
# ----------------------------------------------------------------------

# Assign initial velocities from a Gaussian distribution at reduced temperature 1.0.
velocity all create 1.0 4928459 rot no dist gaussian

# Use a timestep suitable for LJ dynamics.
timestep 0.005

# Integrate the equations of motion.
fix fix_nve all nve

# Apply a Langevin thermostat to maintain the target temperature.
fix fix_langevin all langevin 1.0 1.0 0.1 10917 zero yes


# ----------------------------------------------------------------------
# 4) MONITORING
# ----------------------------------------------------------------------

# Compute per-atom potential energy for trajectory output.
compute peatom all pe/atom

# Compute per-atom kinetic energy for trajectory output.
compute keatom all ke/atom

# Compute per-atom stress tensor components for trajectory output.
compute stressatom all stress/atom NULL

# Compute the number of type-2 neighbors around each type-1 atom
# within the specified cutoff distance.
compute coor12 grp_t1 coord/atom cutoff 2.0 group grp_t2

# Compute the average type-1/type-2 coordination number.
compute sumcoor12 grp_t1 reduce ave c_coor12

# Compute per-atom speed magnitude for trajectory output.
variable vmag atom sqrt(vx*vx+vy*vy+vz*vz)

# Compute per-atom total energy contribution for trajectory output.
variable etotatom atom c_peatom + c_keatom

# Compute per-atom hydrostatic stress-like scalar.
variable p_hydro atom -(c_stressatom[1]+c_stressatom[2]+c_stressatom[3])/3.0

# Count the number of type-1 atoms inside the inner cylinder.
variable n1_in equal count(grp_t1,cyl_in)

# Count the number of type-2 atoms inside the inner cylinder.
variable n2_in equal count(grp_t2,cyl_in)

# Print thermo output every 1000 timesteps.
thermo 1000

# Select thermo columns, including mixing diagnostics.
thermo_style custom step temp etotal pe ke press v_n1_in v_n2_in c_sumcoor12

# Dump PNG frames every 6000 timesteps.
dump dump_png all image 6000 frames/frame_*.png type type size 1200 1200 zoom 1.45 shiny 0.60 fsaa yes view 70 25 box yes 0.025 axes no 0.0 0.0 center s 0.5 0.5 0.5

# Set PNG frame colors and atom diameters.
dump_modify dump_png pad 4 backcolor white boxcolor gray acolor 1 blue acolor 2 red adiam 1 1.6 adiam 2 4.8

# Dump the transient trajectory for post-processing.
dump dump_traj all custom 300 study_4b___transient.lammpstrj id type mass x y z vx vy vz v_vmag fx fy fz c_peatom c_keatom v_etotatom c_stressatom[1] c_stressatom[2] c_stressatom[3] c_stressatom[4] c_stressatom[5] c_stressatom[6] v_p_hydro

# Sort atoms by ID in the trajectory output.
dump_modify dump_traj sort id

# Dump the transient trajectory in XYZ format for visualization/post-processing.
dump dump_xyz all xyz 600 study_4b___transient.xyz


# ----------------------------------------------------------------------
# 5) RUN
# ----------------------------------------------------------------------

# Run the thermostat-controlled molecular dynamics simulation for the mixing study.
run 300000

# Stop PNG frame dumping.
undump dump_png

# Stop transient trajectory dumping.
undump dump_traj

# Stop XYZ trajectory dumping.
undump dump_xyz

# Remove the Langevin thermostat.
unfix fix_langevin

# Remove the NVE time integrator.
unfix fix_nve

# Write the final mixed configuration.
write_data study_4b___mixed.data